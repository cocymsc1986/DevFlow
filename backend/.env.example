ANTHROPIC_API_KEY=
GH_TOKEN=
GH_OWNER=
DATABASE_URL=sqlite:///./devflow.db
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# QA agent (off by default — requires Docker on the host and a built qa-runner image)
QA_ENABLED=false
QA_DOCKER_IMAGE=devflow/qa-runner:latest
QA_DOCKER_NETWORK=devflow-qa
QA_DOCKER_CPUS=2
QA_DOCKER_MEMORY=4g
QA_TIMEOUT_SECONDS=600
QA_ARTIFACT_DIR=./qa_artifacts
QA_MAX_TOOL_TURNS=30
