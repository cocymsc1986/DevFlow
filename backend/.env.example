ANTHROPIC_API_KEY=
GH_TOKEN=
GH_OWNER=
DATABASE_URL=sqlite:///./devflow.db
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# CI observer — after a PR is opened, polls GitHub Actions check runs on the PR
# branch and, on failure, runs a coding revision to try to fix the build.
CI_OBSERVE_ENABLED=true
# Total budget to wait for checks to finish (seconds). Keep this above your
# typical build time. Defaults are tuned for small/fast builds.
CI_OBSERVE_TIMEOUT_SECONDS=120
# How often to poll for check-run status (seconds).
CI_OBSERVE_POLL_SECONDS=15
# How long to wait for *any* check run to appear before concluding the repo has
# no CI. Must be comfortably longer than one poll interval and below the timeout.
CI_OBSERVE_START_GRACE_SECONDS=75
# How many automatic coding revisions to attempt when CI fails. If CI is still
# red after this many attempts, the whole pipeline is failed rather than
# proceeding to PR review.
CI_MAX_REVISIONS=5

# QA agent — runs as a GitHub Actions workflow on cocymsc1986/devflow.
# Off by default; enable once QA_WORKFLOW_REPO + PUBLIC_BASE_URL + QA_CALLBACK_SECRET are set.
QA_ENABLED=false
QA_WORKFLOW_REPO=cocymsc1986/devflow
QA_WORKFLOW_FILE=qa.yml
QA_WORKFLOW_REF=main
QA_WORKFLOW_TIMEOUT_SECONDS=2100
QA_ARTIFACT_DIR=./qa_artifacts
QA_MAX_TOOL_TURNS=30

# Shared HMAC secret used to sign QA worker → control plane callbacks.
# MUST also be set as a GitHub Actions secret of the same name on the workflow repo.
QA_CALLBACK_SECRET=

# Public URL the QA worker uses to POST callbacks back. e.g. http://1.2.3.4 or https://devflow.example.com
PUBLIC_BASE_URL=
